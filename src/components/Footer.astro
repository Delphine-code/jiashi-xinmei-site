---
import siteData from '../data/site-data.json';
const nav = siteData.nav;
---
<footer class="foot">
  <div class="wrap foot__grid">
    <div>
      <p class="foot__brand"><span aria-hidden="true">●</span> 伽师新梅</p>
      <p class="muted">戈壁绿洲上的紫色黄金</p>
    </div>
    <nav aria-label="页脚导航">
      <ul class="foot__links">
        {nav.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
    </nav>
    <div>
      <p class="muted">从开屏地图进入，也可以随时<a href="/jiashi-xinmei-site/entry">回到地图</a>重新选择。</p>
      <p class="muted">数据来源与授权信息见<a href="/jiashi-xinmei-site/about">关于与来源</a>页。</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-y);
    padding-block: 4rem 3rem;
    background: #2d202b;
    color: color-mix(in srgb, var(--c-mist) 78%, transparent);
    font-size: 0.92rem;
  }
  .foot__grid { display: grid; gap: var(--gap); grid-template-columns: 1.1fr 1.4fr 1fr; align-items: start; }
  .foot__brand {
    font-family: var(--font-title);
    font-size: 1.3rem;
    color: var(--c-mist);
    margin-bottom: 0.3rem;
  }
  .foot__brand span { color: var(--c-gold); font-size: 0.75em; vertical-align: 0.12em; }
  .foot__links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem 1rem; }
  .foot a { color: var(--c-gold-soft); text-decoration: none; }
  .foot a:hover, .foot a:focus-visible { color: #fff; text-decoration: underline; }
  .foot .muted { color: color-mix(in srgb, var(--c-mist) 62%, transparent); }
  @media (max-width: 700px) { .foot__grid { grid-template-columns: 1fr; } }
</style>
