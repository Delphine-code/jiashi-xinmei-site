<dialog class="src-modal" data-source-modal>
  <div class="src-modal__box">
    <div class="src-modal__head">
      <span class="src-modal__tag" data-source-tag>来源</span>
      <button type="button" class="src-modal__close" data-source-close aria-label="关闭">×</button>
    </div>
    <p class="src-modal__text" data-source-text></p>
    <p class="src-modal__date" data-source-date></p>
    <a class="src-modal__link" data-source-link target="_blank" rel="noopener noreferrer">打开原始页面</a>
  </div>
</dialog>

<script>
  function sourceInit() {
    const modal = document.querySelector('[data-source-modal]');
    if (!modal || modal.dataset.bound === '1') return;
    modal.dataset.bound = '1';
    const cfgEl = document.getElementById('sources-data');
    let sources = {};
    try { sources = cfgEl ? JSON.parse(cfgEl.textContent) : {}; } catch (e) { sources = {}; }

    const open = (key) => {
      const s = sources[key];
      if (!s) return;
      modal.querySelector('[data-source-tag]').textContent = key;
      modal.querySelector('[data-source-text]').textContent = s.text || '';
      modal.querySelector('[data-source-date]').textContent = s.date ? '时间：' + s.date : '';
      const link = modal.querySelector('[data-source-link]');
      if (s.url) { link.href = s.url; link.style.display = 'inline-block'; }
      else { link.removeAttribute('href'); link.style.display = 'none'; }
      if (typeof modal.showModal === 'function') modal.showModal();
      else modal.setAttribute('open', '');
    };

    document.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-source]');
      if (btn) { ev.preventDefault(); open(btn.dataset.source); return; }
      if (ev.target.closest('[data-source-close]')) { modal.close ? modal.close() : modal.removeAttribute('open'); return; }
      if (ev.target === modal) { modal.close ? modal.close() : modal.removeAttribute('open'); }
    });
  }
  document.addEventListener('astro:page-load', sourceInit);
  if (document.readyState !== 'loading') sourceInit();
  else document.addEventListener('DOMContentLoaded', sourceInit);
</script>

<style>
  .src-modal {
    border: none;
    padding: 0;
    border-radius: var(--radius);
    max-width: min(92vw, 30rem);
    box-shadow: var(--shadow);
    background: var(--c-white);
    color: var(--c-plum-deep);
  }
  .src-modal::backdrop { background: rgba(58, 27, 71, 0.55); backdrop-filter: blur(3px); }
  .src-modal__box { padding: 1.4rem 1.5rem 1.6rem; }
  .src-modal__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; }
  .src-modal__tag {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-gold) 30%, transparent);
    color: var(--c-plum);
  }
  .src-modal__close {
    border: none;
    background: transparent;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    color: var(--c-muted);
  }
  .src-modal__text { font-size: 1.02rem; margin-bottom: 0.4rem; }
  .src-modal__date { font-size: 0.85rem; color: var(--c-muted); margin-bottom: 0.9rem; }
  .src-modal__link { font-size: 0.9rem; color: var(--c-plum); }
</style>