---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>中国 · 伽师新梅</title>
    <meta name="description" content="伽师新梅：戈壁绿洲上的紫色黄金。从一颗新梅出发，沿中国风物地图认识它的产地与故事。" />
    <meta name="theme-color" content="#3a1b47" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="entry">
    <header class="entry__head">
      <p class="entry__kicker">中国风物地图 · 产地索引</p>
      <h1 class="entry__title">伽师新梅</h1>
      <p class="entry__sub">戈壁绿洲上的紫色黄金</p>
    </header>

    <main class="entry__stage" data-entry-stage>
      <div
        class="entry__map"
        id="entry-map"
        data-products={JSON.stringify(provinceProducts)}
        data-xinjiang={JSON.stringify(xinjiangProducts)}
        data-star={JSON.stringify(star)}
        aria-label="中国风物地图，定位新疆与伽师新梅"
      ></div>
      <div class="entry__legend" aria-label="地图图例">
        <span class="entry__legend-item"><i class="entry__legend-dot"></i>特色物产</span>
        <span class="entry__legend-item">
          <button class="entry__legend-meimei" type="button" data-meimei-preview aria-label="放大查看梅梅">
    <img class="entry__legend-star" src="/jiashi-xinmei-site/assets/meimei-map-icon.png" alt="梅梅" />
          </button>
          <span>伽师新梅</span>
        </span>
        <span class="entry__legend-tip">悬停省域查看名称</span>
      </div>
      <div class="entry__tools" aria-label="地图浏览">
          <span class="entry__mode" data-map-mode>全国</span>
        <button type="button" data-map-zoom-in aria-label="放大地图">＋</button>
        <button type="button" data-map-zoom-out aria-label="缩小地图">－</button>
      </div>
      <aside class="entry__places" data-xj-panel hidden>
        <div class="entry__places-head">
          <div>
            <p class="entry__places-kicker">新疆物产 · 24 个地市</p>
            <p class="entry__places-title">从城市看物产</p>
          </div>
          <span class="entry__places-mark">疆</span>
        </div>
        <p class="entry__places-hint">点击城市，查看代表物产</p>
        <div class="entry__places-list" data-xj-list></div>
      </aside>
    </main>

    <div class="entry__info" aria-live="polite">
      <p class="entry__info-main" data-entry-main>先从中国，找到伽师</p>
      <p class="entry__info-sub" data-entry-sub>悬停查看省名 · 点击新疆进入下一级地图 · 点击梅梅进入首页</p>
      <button class="entry__reset" type="button" data-map-reset hidden>回到中国</button>
    </div>

    <p class="entry__note">地图标注各地代表性物产</p>
    <div class="entry__meimei-dialog" data-meimei-dialog hidden role="dialog" aria-modal="true" aria-label="梅梅预览">
      <button class="entry__meimei-close" type="button" data-meimei-close aria-label="关闭梅梅预览">×</button>
      <img src="/jiashi-xinmei-site/assets/meimei-map-icon.png" alt="梅梅·伽师新梅" />
      <p>梅梅 · 伽师新梅</p>
    </div>
  </body>
</html>

<style>
  .entry {
    --entry-map-fill: #e8dff0;
    --entry-map-hover: #d4c5e8;
    --entry-map-selected: #d0bad8;
    --entry-map-line: var(--c-line);
    --entry-paper: var(--c-white);
    --entry-plum: var(--c-plum);
    --entry-muted: var(--c-muted);
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    display: grid;
    grid-template-rows: auto minmax(300px, 1fr) auto auto;
    gap: 0.6rem;
    padding: clamp(1rem, 0.6rem + 2vw, 2.2rem) clamp(1rem, 0.8rem + 2vw, 3rem) 1rem;
    background:
      radial-gradient(circle at 50% -20%, rgba(255, 255, 255, 0.82), transparent 42%),
      linear-gradient(180deg, #f7f3ec 0%, var(--c-mist) 100%);
    color: var(--entry-ink, var(--c-plum-deep));
    font-family: var(--font-body);
  }
  .entry__head { text-align: center; animation: entryUp 0.9s var(--ease) both; }
  .entry__kicker { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--c-gold); margin: 0 0 0.55rem; }
  .entry__title {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.4rem);
    margin: 0;
    line-height: 1.05;
    color: var(--entry-plum);
  }
  .entry__sub { font-size: clamp(0.9rem, 0.8rem + 0.5vw, 1.05rem); color: var(--entry-muted); margin: 0.35rem 0 0; }
  .entry__stage {
    position: relative;
    height: 100%;
    min-height: 300px;
    border-block: 1px solid color-mix(in srgb, var(--c-line) 82%, transparent);
    animation: entryMap 1.4s var(--ease) 0.15s both;
  }
  .entry__map { position: relative; height: 100%; min-height: 300px; }
  .entry__map { transition: transform 0.35s var(--ease), opacity 0.35s var(--ease); }
  .entry.is-entering .entry__map { transform: scale(1.025); opacity: 0.72; }
  .entry.is-xj-transition .entry__map { transform: scale(1.04); opacity: 0.82; }
  .entry__places {
    position: absolute;
    z-index: 5;
    top: 50%;
    right: 0.4rem;
    width: clamp(225px, 24vw, 300px);
    max-height: min(72%, 480px);
    overflow: auto;
    padding: 1rem;
    border: 1px solid var(--c-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--entry-paper) 94%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(12px);
    transform: translateY(-50%);
    animation: entryUp 0.5s var(--ease) both;
  }
  .entry__places[hidden] { display: none; }
  .entry__places-head { display: flex; align-items: center; justify-content: space-between; gap: 0.7rem; }
  .entry__places-kicker { margin: 0 0 0.15rem; color: var(--c-gold); font-size: 0.62rem; letter-spacing: 0.12em; }
  .entry__places-title { margin: 0; color: var(--entry-plum); font-family: var(--font-title); font-size: 1.15rem; }
  .entry__places-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--c-gold); border-radius: 50%; color: var(--c-gold); font-family: var(--font-title); }
  .entry__places-hint { margin: 0.25rem 0 0.75rem; color: var(--entry-muted); font-size: 0.72rem; }
  .entry__places-list { display: grid; grid-template-columns: 1fr; gap: 0.28rem; }
  .entry__place {
    appearance: none;
    width: 100%;
    border: 0;
    text-align: left;
    font: inherit;
    background: color-mix(in srgb, var(--entry-plum) 5%, transparent) !important;
    color: var(--entry-plum) !important;
    display: flex;
    justify-content: space-between;
    gap: 0.55rem;
    padding: 0.35rem 0.45rem;
    border-radius: 0.45rem;
    color: var(--entry-plum);
    font-size: 0.74rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .entry__place:hover, .entry__place:focus-visible, .entry__place.is-active { background: color-mix(in srgb, var(--c-gold) 18%, var(--entry-paper)) !important; color: var(--entry-plum) !important; }
  .entry__place:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 1px; }
  .entry__place-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .entry__place-product { color: var(--entry-muted); white-space: nowrap; }
  .entry__info { text-align: center; animation: entryUp 0.9s var(--ease) 0.4s both; }
  .entry__info-main { font-family: var(--font-title); font-size: clamp(1.05rem, 0.95rem + 0.7vw, 1.35rem); margin: 0; color: var(--entry-plum); }
  .entry__info-main .hl { color: var(--c-gold); }
  .entry__info-sub { margin: 0.3rem 0 0; font-size: 0.82rem; color: var(--entry-muted); }
  .entry__enter-xj {
    margin: 0.7rem 0 0;
    padding: 0.55rem 1.15rem;
     border: 1px solid var(--c-gold);
     border-radius: 3px;
     background: var(--c-gold);
     color: #fff;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
     box-shadow: none;
    transition: transform 0.2s var(--ease), background 0.2s var(--ease);
  }
   .entry__enter-xj:hover { transform: translateY(-2px); background: #c79c58; }
  .entry__enter-xj[hidden] { display: none; }
  .entry__reset {
    margin: 0.65rem 0 0;
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--c-line);
     border-radius: 3px;
    background: color-mix(in srgb, var(--entry-plum) 6%, var(--entry-paper));
    color: var(--entry-plum);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .entry__reset:hover { background: color-mix(in srgb, var(--entry-plum) 12%, var(--entry-paper)); border-color: var(--c-gold); }
  .entry__reset[hidden] { display: none; }
  .entry__note { text-align: center; font-size: 0.72rem; color: var(--entry-muted); margin: 0.4rem 0 0; }
  .entry__legend {
    position: absolute;
    left: 0.35rem;
    bottom: 0.55rem;
    display: grid;
    gap: 0.35rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--c-line);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--entry-paper) 86%, transparent);
    backdrop-filter: blur(8px);
    color: var(--entry-muted);
    font-size: 0.68rem;
  }
  .entry__legend-item { display: inline-flex; align-items: center; gap: 0.42rem; }
  .entry__legend-tip { padding-top: 0.18rem; border-top: 1px solid var(--c-line); color: var(--entry-muted); font-size: 0.62rem; }
  .entry__legend-dot { width: 0.52rem; height: 0.52rem; display: inline-block; border-radius: 50%; background: var(--c-jade); box-shadow: 0 0 8px color-mix(in srgb, var(--c-jade) 55%, transparent); }
  .entry__legend-meimei { width: 1.35rem; height: 1.35rem; display: grid; place-items: center; flex: 0 0 auto; padding: 0; border: 1px solid var(--c-gold); border-radius: 50%; background: var(--c-gold-soft); cursor: zoom-in; overflow: hidden; transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .entry__legend-meimei:hover, .entry__legend-meimei:focus-visible { transform: scale(1.1); box-shadow: 0 4px 12px rgba(48,37,43,0.16); outline: none; }
  .entry__legend-star { width: 100%; height: 100%; display: block; object-fit: contain; }
  .entry__meimei-dialog { position: fixed; z-index: 20; inset: 0; display: grid; place-items: center; padding: 2rem; background: rgba(49, 32, 57, 0.74); backdrop-filter: blur(8px); }
  .entry__meimei-dialog[hidden] { display: none; }
  .entry__meimei-dialog img { width: min(58vw, 360px); max-height: 68vh; object-fit: contain; filter: drop-shadow(0 20px 28px rgba(20,12,25,0.3)); }
  .entry__meimei-dialog p { position: absolute; bottom: 2rem; margin: 0; color: #fffaf3; font-family: var(--font-title); font-size: 1.1rem; }
  .entry__meimei-close { position: absolute; top: 1.2rem; right: 1.4rem; width: 2.5rem; height: 2.5rem; border: 1px solid rgba(255,255,255,0.55); border-radius: 50%; background: rgba(255,255,255,0.12); color: #fff; font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .entry__tools { position: absolute; right: 0.35rem; bottom: 0.55rem; display: flex; align-items: center; gap: 0.3rem; }
  .entry__mode { margin-right: 0.25rem; padding: 0.38rem 0.58rem; border: 1px solid var(--c-line); border-radius: 999px; color: var(--entry-muted); background: color-mix(in srgb, var(--entry-paper) 88%, transparent); font-size: 0.68rem; }
  .entry__tools button { width: 1.8rem; height: 1.8rem; padding: 0; border: 1px solid var(--c-line); border-radius: 50%; background: var(--entry-paper); color: var(--entry-plum); font-size: 1.05rem; line-height: 1; cursor: pointer; }
  .entry__tools button:hover, .entry__tools button:focus-visible { background: var(--c-gold); border-color: var(--c-gold); color: #fff; }
  .entry__info { max-width: min(92vw, 860px); margin-inline: auto; }
  .entry__info-sub { line-height: 1.55; text-wrap: balance; }
  @media (max-width: 700px) {
    .entry { grid-template-rows: auto minmax(360px, 1fr) auto auto; }
    .entry__stage, .entry__map { min-height: 360px; }
    .entry__places { top: auto; right: 0.35rem; bottom: 0.35rem; left: 0.35rem; width: auto; max-height: 38%; padding: 0.65rem; transform: none; }
    .entry__places-title { font-size: 0.95rem; }
    .entry__places-hint { margin-bottom: 0.4rem; }
    .entry__places-list { grid-template-columns: 1fr 1fr; gap: 0.12rem 0.35rem; }
    .entry__place { padding: 0.25rem; font-size: 0.65rem; }
