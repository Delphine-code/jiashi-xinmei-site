    .entry__legend { left: 0.1rem; bottom: 0.25rem; }
    .entry__legend-tip { display: none; }
    .entry__tools { right: 0.1rem; bottom: 0.25rem; }
    .entry__mode { display: none; }
  }
  @media screen and (min-width: 1000px) and (orientation: landscape) {
    .entry {
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      gap: 0.35rem;
      padding: 0.7rem clamp(1.4rem, 3vw, 3.2rem) 0.55rem;
    }
    .entry__head { line-height: 1.2; }
    .entry__kicker { font-size: 0.68rem; margin-bottom: 0.28rem; }
    .entry__title { font-size: clamp(2.35rem, 4.2vw, 3.8rem); }
    .entry__sub { font-size: 0.94rem; margin-top: 0.18rem; }
    .entry__stage, .entry__map { min-height: 0; }
    .entry__info-main { font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem); }
    .entry__info-sub { font-size: 0.8rem; margin-top: 0.12rem; }
    .entry__info-sub { max-width: 52rem; margin-inline: auto; }
    .entry__note { font-size: 0.68rem; margin-top: 0.15rem; }
    .entry__legend { left: 0.45rem; bottom: 0.45rem; font-size: 0.74rem; padding: 0.6rem 0.75rem; }
    .entry__tools { right: 0.45rem; bottom: 0.45rem; gap: 0.38rem; }
    .entry__mode { font-size: 0.74rem; padding: 0.4rem 0.62rem; }
    .entry__tools button { width: 2rem; height: 2rem; font-size: 1.1rem; }
    .entry__places { width: clamp(250px, 23vw, 320px); max-height: min(76%, 500px); padding: 1.05rem; }
    .entry__places-kicker { font-size: 0.68rem; }
    .entry__places-title { font-size: 1.22rem; }
    .entry__places-hint { font-size: 0.76rem; }
    .entry__place { font-size: 0.78rem; padding: 0.4rem 0.48rem; }
  }
  @media screen and (min-width: 1000px) and (max-height: 700px) and (orientation: landscape) {
    .entry { padding-top: 0.45rem; padding-bottom: 0.35rem; }
    .entry__title { font-size: clamp(2.1rem, 3.6vw, 3rem); }
    .entry__sub { font-size: 0.88rem; }
    .entry__info-main { font-size: 1rem; }
    .entry__places { max-height: 70%; padding: 0.8rem; }
    .entry__places-list { gap: 0.18rem; }
    .entry__place { padding-block: 0.3rem; }
  }
  @keyframes entryUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes entryMap { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .entry__head, .entry__map, .entry__info { animation: none; }
  }
</style>

<script>
  import * as echarts from 'echarts';

  function entryInit() {
    const el = document.getElementById('entry-map');
    if (!el || el.dataset.bound === '1') return;
    el.dataset.bound = '1';
    const products = JSON.parse(el.dataset.products || '[]');
    const xinjiangProducts = JSON.parse(el.dataset.xinjiang || '[]');
    const star = JSON.parse(el.dataset.star || '{}');
    const infoMain = document.querySelector('[data-entry-main]');
    const infoSub = document.querySelector('[data-entry-sub]');
    const resetButton = document.querySelector('[data-map-reset]');
    const modeLabel = document.querySelector('[data-map-mode]');
    const zoomInButton = document.querySelector('[data-map-zoom-in]');
    const zoomOutButton = document.querySelector('[data-map-zoom-out]');
    const xinjiangPanel = document.querySelector('[data-xj-panel]');
    const xinjiangList = document.querySelector('[data-xj-list]');
    const root = document.querySelector('.entry');
    const meimeiOpen = document.querySelector('[data-meimei-preview]');
    const meimeiDialog = document.querySelector('[data-meimei-dialog]');
    const meimeiClose = document.querySelector('[data-meimei-close]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const closeMeimei = () => { if (meimeiDialog) meimeiDialog.hidden = true; };
    meimeiOpen?.addEventListener('click', () => { if (meimeiDialog) meimeiDialog.hidden = false; });
    meimeiClose?.addEventListener('click', closeMeimei);
    meimeiDialog?.addEventListener('click', (event) => { if (event.target === meimeiDialog) closeMeimei(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMeimei(); });
    let entering = false;
    let selectedProvince = '';
    let selectedCity = '';
    let mode = 'china';
    let chinaGeo = null;
    let xinjiangGeo = null;
    let currentView = { center: [104, 35], zoom: 1.15 };
    let viewFrame = 0;
    let provinceTimer = 0;

    const chinaNames = {
      110000: '北京市', 120000: '天津市', 130000: '河北省', 140000: '山西省',
      150000: '内蒙古自治区', 210000: '辽宁省', 220000: '吉林省', 230000: '黑龙江省',
      310000: '上海市', 320000: '江苏省', 330000: '浙江省', 340000: '安徽省',
      350000: '福建省', 360000: '江西省', 370000: '山东省', 410000: '河南省',
      420000: '湖北省', 430000: '湖南省', 440000: '广东省', 450000: '广西壮族自治区',
      460000: '海南省', 500000: '重庆市', 510000: '四川省', 520000: '贵州省',
      530000: '云南省', 540000: '西藏自治区', 610000: '陕西省', 620000: '甘肃省',
      630000: '青海省', 640000: '宁夏回族自治区', 650000: '新疆维吾尔自治区',
      710000: '台湾省', 810000: '香港特别行政区', 820000: '澳门特别行政区'
    };
    const xinjiangNames = {
      650100: '乌鲁木齐市', 650200: '克拉玛依市', 650400: '吐鲁番市', 650500: '哈密市',
      652300: '昌吉回族自治州', 652700: '博尔塔拉蒙古自治州', 652800: '巴音郭楞蒙古自治州',
      652900: '阿克苏地区', 653000: '克孜勒苏柯尔克孜自治州', 653100: '喀什地区',
      653200: '和田地区', 654000: '伊犁哈萨克自治州', 654200: '塔城地区', 654300: '阿勒泰地区',
      659001: '石河子市', 659002: '阿拉尔市', 659003: '图木舒克市', 659004: '五家渠市',
      659005: '北屯市', 659006: '铁门关市', 659007: '双河市', 659008: '可克达拉市',
      659009: '昆玉市', 659010: '胡杨河市'
    };

    function restoreGeoNames(geo, names) {
      geo.features.forEach((feature) => {
        const name = names[feature.properties?.adcode];
        if (name) feature.properties.name = name;
      });
      return geo;
    }

    const chart = echarts.init(el);
    window.addEventListener('resize', () => chart.resize());

    const assetBase = '/jiashi-xinmei-site/';
    Promise.all([fetch(`${assetBase}geo/china.json`, { cache: 'no-store' }).then((r) => r.json()), fetch(`${assetBase}geo/xinjiang.json`, { cache: 'no-store' }).then((r) => r.json())])
      .then(([china, xinjiang]) => {
        chinaGeo = restoreGeoNames(china, chinaNames);
        xinjiangGeo = restoreGeoNames(xinjiang, xinjiangNames);
        echarts.registerMap('china', chinaGeo);
        echarts.registerMap('xinjiang', xinjiangGeo);
        paintMap(false);
      })
      .catch(() => { if (infoMain) infoMain.textContent = '地图数据加载失败，请刷新重试。'; });

    function centroid(feature) {
      let x = 0, y = 0, count = 0;
      const walk = (coords) => {
        if (typeof coords[0] === 'number') { x += coords[0]; y += coords[1]; count += 1; return; }
        coords.forEach(walk);
      };
      if (feature?.geometry?.coordinates) walk(feature.geometry.coordinates);
      return count ? [x / count, y / count] : null;
    }

    function provinceBounds(feature) {
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      const walk = (coords) => {
        if (typeof coords[0] === 'number') {
          minX = Math.min(minX, coords[0]); maxX = Math.max(maxX, coords[0]);
          minY = Math.min(minY, coords[1]); maxY = Math.max(maxY, coords[1]);
          return;
        }
        coords.forEach(walk);
      };
      if (feature?.geometry?.coordinates) walk(feature.geometry.coordinates);
      return minX === Infinity ? null : [[minX, minY], [maxX, maxY]];
    }

    function regionLabel(name, localMode) {
      if (localMode) return name.replace(/柯尔克孜自治州|蒙古自治州|自治州|地区|市/g, '');
      return name.replace(/维吾尔自治区|壮族自治区|回族自治区|自治区|特别行政区|省|市/g, '');
    }

    function regionLabelOffset(name, localMode) {
      if (localMode) {
        return {
          '乌鲁木齐市': [0, -8],
          '克拉玛依市': [0, -8],
          '吐鲁番市': [0, 8],
          '哈密市': [0, -8],
          '昌吉回族自治州': [0, -8],
          '博尔塔拉蒙古自治州': [0, -8],
          '巴音郭楞蒙古自治州': [0, -8],
          '阿克苏地区': [0, -8],
          '克孜勒苏柯尔克孜自治州': [0, -8],
          '喀什地区': [0, -8],
          '和田地区': [0, -8],
          '伊犁哈萨克自治州': [0, -8],
          '塔城地区': [0, -8],
          '阿勒泰地区': [0, -8],
          '石河子市': [0, -8],
          '阿拉尔市': [0, -8],
          '图木舒克市': [0, -8],
          '五家渠市': [0, -8],
          '北屯市': [0, -8],
          '铁门关市': [0, -8],
          '双河市': [0, -8],
          '可克达拉市': [0, -8],
          '昆玉市': [0, -8],
          '胡杨河市': [0, -8]
        }[name] || [0, 0];
      }
      return {
        '北京市': [8, 2],
        '天津市': [10, 6],
        '上海市': [8, 5],
        '江苏省': [5, -2],
        '浙江省': [8, 5],
        '福建省': [7, 5],
        '广东省': [2, 5],
        '海南省': [0, 6],
        '香港特别行政区': [10, 6],
        '澳门特别行政区': [10, 10]
      }[name] || [0, 0];
    }

    function regionPoint(name, feature, localMode) {
      if (localMode) {
        const product = xinjiangProducts.find((item) => item.city === name);
        if (product) return product.coord;
      }
      return centroid(feature);
    }

    function focusView(feature) {
      const bounds = provinceBounds(feature);
      if (!bounds) return { center: [104, 35], zoom: 1.15 };
      const [[minX, minY], [maxX, maxY]] = bounds;
      const width = Math.max(maxX - minX, 1.2);
      const height = Math.max(maxY - minY, 1.2);
      const zoom = Math.max(1.45, Math.min(4.2, Math.min(62 / width, 36 / height) * 0.68));
      return { center: [(minX + maxX) / 2, (minY + maxY) / 2], zoom };
    }

    function animateView(nextView, animate) {
      cancelAnimationFrame(viewFrame);
      const start = { center: [...currentView.center], zoom: currentView.zoom };
      if (!animate || reduce) {
        currentView = nextView;
        chart.setOption({ geo: { center: nextView.center, zoom: nextView.zoom } });
        return;
      }
      const startedAt = performance.now();
      const duration = 650;
      const tick = (now) => {
        const progress = Math.min(1, (now - startedAt) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const center = start.center.map((value, index) => value + (nextView.center[index] - value) * eased);
        const zoom = start.zoom + (nextView.zoom - start.zoom) * eased;
        chart.setOption({ geo: { center, zoom } });
        if (progress < 1) viewFrame = requestAnimationFrame(tick);
        else currentView = nextView;
      };
      viewFrame = requestAnimationFrame(tick);
    }

    function paintMap(animate = true) {
      if (!chinaGeo) return;
      const localMode = mode === 'xinjiang';
      const mapGeo = localMode ? xinjiangGeo : chinaGeo;
      const mapName = localMode ? 'xinjiang' : 'china';
      const targetName = localMode ? selectedCity : selectedProvince;
      const target = mapGeo.features.find((feature) => feature.properties.name === targetName);
      const product = localMode
        ? xinjiangProducts.find((item) => item.city === selectedCity)
        : products.find((item) => item.province === selectedProvince);
      const defaultView = localMode ? { center: [86, 42.5], zoom: 1.15 } : { center: [104, 35], zoom: 1.15 };
      const nextView = target ? focusView(target) : mode === 'china-flight'
        ? { center: [86, 42.5], zoom: 3.1 }
        : defaultView;
      const mapData = mapGeo.features.map((feature) => ({
        name: feature.properties.name,
        itemStyle: feature.properties.name === targetName
          ? { areaColor: '#d0bad8', borderColor: '#6b344d', borderWidth: 1.6, shadowBlur: 0, shadowColor: 'transparent' }
          : { areaColor: '#e8dff0', borderColor: '#d8d0c5', borderWidth: 0.8 }
      }));
      const visibleProducts = localMode
        ? xinjiangProducts.filter((item) => item.name !== star.name)
        : products;
      const series = [{
        name: localMode ? '新疆地州市' : '省级区域', type: 'map', map: mapName, geoIndex: 0, data: mapData,
         label: {
           show: false,
           position: 'inside',
           formatter: (params) => localMode ? params.name : regionLabel(params.name, false),
           color: '#6e6178',
           fontSize: localMode ? (window.innerWidth <= 700 ? 7 : 8) : (window.innerWidth <= 700 ? 7 : 8),
           fontWeight: 400,
           textBorderColor: 'rgba(48,37,43,0.82)',
           textBorderWidth: 2.4,
           hideOverlap: false
         },
         labelLayout: { hideOverlap: false },
         emphasis: {
           show: true,
           focus: 'self',
           itemStyle: {
              areaColor: '#d4c5e8',
              borderColor: '#d8d0c5',
              borderWidth: 0.8,
              shadowBlur: 0,
              shadowColor: 'transparent'
           },
            label: {
              show: true,
              position: 'inside',
              formatter: (params) => regionLabel(params.name, localMode),
              color: '#6b344d',
              fontWeight: 700,
              backgroundColor: 'rgba(255,255,255,0.94)',
              borderColor: 'rgba(196,181,217,0.9)',
              borderWidth: 1,
              borderRadius: 999,
              padding: [3, 7],
              textBorderWidth: 0,
              fontSize: localMode ? 10 : 11
            }
         },
         select: { disabled: true },
         blur: { itemStyle: { opacity: 0.72 } },
         cursor: 'pointer'
      }, {
        name: localMode ? '新疆地市物产' : '省级物产', type: 'scatter', coordinateSystem: 'geo',
        data: visibleProducts.map((item) => {
          const isSelected = localMode ? item.city === selectedCity : item.province === selectedProvince;
          return {
            name: item.name,
            value: item.coord,
            city: item.city,
            province: item.province,
            note: item.note,
            itemStyle: isSelected ? { color: '#b58a45', borderColor: '#fff', borderWidth: 1.8, shadowBlur: 10, shadowColor: 'rgba(181,138,69,0.36)' } : undefined,
            label: isSelected ? { show: true, fontSize: localMode ? 11 : 12, color: '#6b344d', fontWeight: 700 } : undefined
          };
        }),
        symbolSize: (value, params) => {
          const item = visibleProducts[params.dataIndex];
          const isSelected = localMode ? item?.city === selectedCity : item?.province === selectedProvince;
          return isSelected ? (localMode ? 13 : 14) : (localMode ? 8 : 9);
        },
        itemStyle: { color: '#7cb342', borderColor: '#fff', borderWidth: 1.2, shadowBlur: 9, shadowColor: 'rgba(124,179,66,0.45)' },
         label: { show: true, position: 'right', distance: 4, formatter: '{b}', fontSize: 11, color: '#5a4a6a', textBorderColor: 'transparent', textBorderWidth: 0, textShadowColor: 'rgba(255,255,255,0.45)', textShadowBlur: 2, fontWeight: 600, hideOverlap: true },
        labelLayout: { hideOverlap: true },
         tooltip: {
           trigger: 'item',
           backgroundColor: '#fff',
           borderColor: '#d8d0c5',
           borderWidth: 1,
           textStyle: { color: '#6b344d', fontSize: 12 },
           formatter: (params) => `<strong>${params.data?.city || params.data?.province || ''}</strong><br>${params.name}<br>${params.data?.note || ''}`
         },
        emphasis: { scale: 1.25, label: { show: true, color: '#6b344d', fontWeight: 700 }, itemStyle: { color: '#8ba56b' } },
        zlevel: 2, cursor: 'pointer'
      }];
      const regionNames = mapGeo.features.map((feature) => {
        const name = feature.properties.name;
        const isSelected = name === targetName;
        return {
          name: regionLabel(name, localMode),
          value: regionPoint(name, feature, localMode),
          region: name,
          itemStyle: { color: 'transparent' },
          label: isSelected ? {
            show: isSelected && localMode,
            offset: regionLabelOffset(name, localMode),
            color: '#ffd98a',
            fontWeight: 700,
            backgroundColor: 'rgba(91,44,111,0.92)',
            borderColor: '#d8a85a',
            borderWidth: 1,
            borderRadius: 999,
            padding: [3, 7]
          } : {
            show: false,
            position: localMode ? 'top' : 'right',
            distance: localMode ? 5 : 0,
            offset: regionLabelOffset(name, localMode),
             color: '#6b344d',
            fontSize: localMode ? (window.innerWidth <= 700 ? 7 : 8) : (window.innerWidth <= 700 ? 8 : 9),
            fontWeight: 500,
            textBorderColor: 'rgba(48,37,43,0.92)',
            textBorderWidth: 2.5
          }
        };
      }).filter((item) => item.value && (localMode || item.region !== '新疆维吾尔自治区'));
      series.splice(1, 0, {
        name: localMode ? '新疆地市名称' : '省份名称',
        type: 'scatter',
        coordinateSystem: 'geo',
        data: regionNames,
        symbol: 'circle',
        symbolSize: localMode ? 4 : 5,
        silent: false,
        itemStyle: { color: 'transparent', borderColor: 'transparent', borderWidth: 0 },
         label: {
           show: false,
           formatter: '{b}',
           color: '#6b344d',
           fontSize: localMode ? (window.innerWidth <= 700 ? 7 : 8) : (window.innerWidth <= 700 ? 8 : 9),
           fontWeight: 500,
           textBorderColor: 'rgba(48,37,43,0.92)',
           textBorderWidth: 2.5,
           hideOverlap: false
         },
         labelLayout: { hideOverlap: false },
        emphasis: {
          scale: 1.12,
          itemStyle: { color: 'rgba(255,217,138,0.12)' },
           label: {
             show: false
          }
        },
        tooltip: { show: false },
        zlevel: 2,
        cursor: 'pointer'
      });
      if (!localMode) {
        const xinjiangFeature = chinaGeo.features.find((feature) => feature.properties.name === '新疆维吾尔自治区');
        const xinjiangCenter = centroid(xinjiangFeature) || [85, 42.5];
        series.push({
          name: '新疆省份名称', type: 'scatter', coordinateSystem: 'geo',
          data: [{ name: '新疆', value: xinjiangCenter, province: '新疆维吾尔自治区' }],
          symbolSize: 2,
          itemStyle: { color: 'transparent' },
          label: {
            show: true, position: 'inside', formatter: '新疆',
            color: '#fffaf3', fontSize: window.innerWidth <= 700 ? 10 : 12, fontWeight: 700,
            backgroundColor: '#6b344d', borderColor: '#b58a45', borderWidth: 1,
            borderRadius: 999, padding: [4, 9], textBorderWidth: 0
          },
          emphasis: { label: { color: '#fff', backgroundColor: '#6b344d', borderWidth: 1 } },
          tooltip: { show: false }, zlevel: 3, cursor: 'pointer'
        });
      }
      if (star?.coord) series.push({
        name: '重点', type: 'scatter', coordinateSystem: 'geo',
        data: [{ name: star.name, value: star.coord, province: '新疆维吾尔自治区', city: '喀什地区', note: '新疆特色果品 · 重点推荐' }],
        symbol: 'image:///jiashi-xinmei-site/assets/meimei-map.png', symbolSize: 40,
        itemStyle: { shadowBlur: 18, shadowColor: 'rgba(255,217,138,0.8)' },
        label: { show: true, position: 'top', distance: 7, formatter: star.name, fontSize: 15, fontWeight: 700, color: '#6b344d', textBorderColor: 'transparent', textBorderWidth: 0, textShadowColor: 'rgba(255,255,255,0.45)', textShadowBlur: 2 },
        tooltip: {
          trigger: 'item',
          backgroundColor: '#fff',
          borderColor: '#d8d0c5',
          borderWidth: 1,
          textStyle: { color: '#6b344d', fontSize: 12 },
          formatter: (params) => `<strong>${params.data?.province || ''}</strong><br>${params.name}<br>${params.data?.note || ''}`
        },
        zlevel: 3, cursor: 'pointer'
      });

      const option = {
        backgroundColor: 'transparent',
        geo: {
          map: mapName, roam: true, silent: false,
          layoutCenter: localMode ? [window.innerWidth <= 700 ? '50%' : '42%', window.innerWidth <= 700 ? '42%' : '50%'] : ['50%', '50%'],
          layoutSize: localMode ? (window.innerWidth <= 700 ? '78%' : '86%') : '94%',
          itemStyle: { areaColor: '#e8dff0', borderColor: '#d8d0c5', borderWidth: 0.8 },
          emphasis: {
            disabled: false,
            itemStyle: {
              areaColor: '#d4c5e8',
              borderColor: '#d8d0c5',
              borderWidth: 0.8,
              shadowBlur: 0,
              shadowColor: 'transparent'
            }
          },
          label: { show: false },
          center: currentView.center,
          zoom: currentView.zoom
        },
        series,
        animation: animate && !reduce,
        animationDurationUpdate: animate && !reduce ? 700 : 0,
        animationEasingUpdate: 'cubicInOut'
      };
      chart.setOption(option, { notMerge: true });
      animateView(nextView, animate);
      if (modeLabel) modeLabel.textContent = localMode ? '新疆' : selectedProvince ? '定位' : '全国';
      if (resetButton) {
        resetButton.hidden = !selectedProvince && !localMode;
        const returnLabel = localMode && selectedCity ? '回到新疆' : '回到中国';
        resetButton.textContent = returnLabel;
        resetButton.setAttribute('aria-label', `${returnLabel}地图`);
      }
      if (xinjiangPanel) xinjiangPanel.hidden = !localMode;
      if (xinjiangList && localMode && xinjiangList.childElementCount === 0) {
        xinjiangProducts.forEach((item) => {
          const row = document.createElement('button');
          row.type = 'button';
          row.setAttribute('aria-label', `${item.city}：${item.name}`);
          row.className = 'entry__place';
          row.dataset.city = item.city;
          const city = document.createElement('span');
          city.className = 'entry__place-name';
          city.textContent = item.city.replace(/自治州|蒙古自治州|柯尔克孜自治州|地区|市/g, '');
          const name = document.createElement('span');
          name.className = 'entry__place-product';
          name.textContent = item.name;
          row.append(city, name);
          xinjiangList.append(row);
        });
      }
      xinjiangList?.querySelectorAll('.entry__place').forEach((row) => row.classList.toggle('is-active', row.dataset.city === selectedCity));
      if (localMode && product) {
        if (infoMain) infoMain.innerHTML = '<span class="hl">' + product.city + '</span> · ' + product.name;
        if (infoSub) infoSub.textContent = product.note;
      } else if (selectedProvince && product) {
        if (infoMain) infoMain.innerHTML = '<span class="hl">' + product.province + '</span> · ' + product.name;
        if (infoSub) infoSub.textContent = product.note;
      } else {
        if (infoMain) infoMain.textContent = localMode ? '新疆风物坐标' : '先从中国，找到伽师';
        if (infoSub) infoSub.textContent = localMode ? '点击城市，查看代表物产' : '悬停查看省名 · 点击新疆进入下一级地图 · 点击梅梅进入首页';
      }
    }

    function zoomMap(delta) {
      const min = mode === 'xinjiang' ? 0.85 : 0.92;
      const max = mode === 'xinjiang' ? 3.8 : 2.2;
      const next = Math.max(min, Math.min(max, currentView.zoom + delta));
      animateView({ center: [...currentView.center], zoom: next }, true);
    }

    zoomInButton?.addEventListener('click', () => zoomMap(0.2));
    zoomOutButton?.addEventListener('click', () => zoomMap(-0.2));

    function enterXinjiang() {
      if (mode !== 'china' || selectedProvince !== '新疆维吾尔自治区') return;
      window.clearTimeout(provinceTimer);
      mode = 'china-flight';
      root?.classList.add('is-xj-transition');
      paintMap(true);
      provinceTimer = window.setTimeout(() => {
        if (mode !== 'china-flight') return;
        mode = 'xinjiang';
        selectedCity = '';
        currentView = { center: [86, 42.5], zoom: 1.15 };
        root?.classList.remove('is-xj-transition');
        paintMap(false);
      }, reduce ? 0 : 720);
    }

    resetButton?.addEventListener('click', () => {
      window.clearTimeout(provinceTimer);
      if (mode === 'xinjiang') {
        if (selectedCity) {
          selectedCity = '';
          currentView = { center: [86, 42.5], zoom: 1.15 };
          paintMap(true);
          return;
        }
        mode = 'china';
        selectedProvince = '';
        currentView = { center: [104, 35], zoom: 1.15 };
        paintMap(true);
        return;
      }
      mode = 'china';
      selectedProvince = '';
      selectedCity = '';
      currentView = { center: [104, 35], zoom: 1.15 };
      paintMap(true);
    });

    xinjiangList?.addEventListener('click', (event) => {
      const row = event.target.closest('[data-city]');
      if (!row || mode !== 'xinjiang') return;
      selectedCity = row.dataset.city;
      paintMap(false);
    });

    chart.on('click', (p) => {
      if (!p || !p.name) return;
      if (p.seriesType === 'scatter' && p.seriesName === '重点' && p.name === star.name) {
        if (entering) return;
        entering = true;
        root?.classList.add('is-entering');
        if (infoMain) infoMain.innerHTML = '<span class="hl">伽师新梅</span> · 即将进入故事';
        if (infoSub) infoSub.textContent = '从产地出发，继续认识风土、产业与人物';
        window.setTimeout(() => window.location.assign('/'), reduce ? 0 : 260);
        return;
      }
      if (mode === 'xinjiang') {
        if (p.seriesName === '新疆地市名称' && p.data?.region) {
          selectedCity = p.data.region;
          paintMap(true);
          return;
        }
        const city = p.seriesType === 'scatter' ? p.data?.city : p.name;
        if (city && xinjiangProducts.some((item) => item.city === city)) {
          selectedCity = city;
          paintMap(true);
        }
        return;
      }
      if (p.seriesName === '省份名称' && p.data?.region) {
        selectedProvince = p.data.region;
        paintMap(true);
        if (selectedProvince === '新疆维吾尔自治区') enterXinjiang();
        return;
      }
      const province = p.seriesType === 'scatter' ? p.data?.province : p.name;
      if (province === '新疆维吾尔自治区') {
        window.clearTimeout(provinceTimer);
        selectedProvince = province;
        mode = 'china';
        paintMap(true);
        enterXinjiang();
      } else if (province && products.some((item) => item.province === province)) {
        selectedProvince = province;
        mode = 'china';
        paintMap(true);
      }
    });
  }

  document.addEventListener('astro:page-load', entryInit);
  if (document.readyState !== 'loading') entryInit();
  else document.addEventListener('DOMContentLoaded', entryInit);
</script>
