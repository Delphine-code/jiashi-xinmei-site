---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import StatCard from '../components/StatCard.astro';
import FigureBlock from '../components/FigureBlock.astro';
import SourceBadge from '../components/SourceBadge.astro';
import siteData from '../data/site-data.json';

const { hero, people, homeTeasers, photos } = siteData;
const voice = people[0];
---

<BaseLayout title="伽师新梅 · 戈壁绿洲上的紫色黄金" description={hero.lead}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">{hero.kicker}</p>
        <h1 class="hero__title" transition:name="page-title">{hero.title}</h1>
        <p class="hero__sub">{hero.titleSub}</p>
        <p class="hero__lead">{hero.lead}</p>
        <div class="hero__cta">
          <a class="btn btn--solid" href="/jiashi-xinmei-site/terroir">开始阅读：风土 →</a>
          <a class="btn" href="/jiashi-xinmei-site/data">跳到产业数据</a>
          <a class="btn" href="/jiashi-xinmei-site/entry">返回开屏地图 ↗</a>
        </div>
      </div>

      <figure class="hero__art">
        <img src="/jiashi-xinmei-site/assets/home/orchard-hero.webp" alt="伽师新梅挂在果树枝头" />
        <figcaption>枝头的新梅 · 伽师果园</figcaption>
      </figure>

      <div class="hero__stats grid">
        {hero.stats.map((s) => (<StatCard value={s.value} unit={s.unit} label={s.label} src={s.src} />))}
      </div>
    </div>
    <div class="hero__cue" aria-hidden="true"><span></span></div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionTitle no="01" title="从一颗果开始" sub="风土、产业、成分，三条线索进入伽师新梅。" />
      <div class="teaser-list">
        {homeTeasers.map((t) => (
          <a class="teaser" href={t.href}>
            <p class="teaser__num">{t.num}<span class="teaser__unit">{t.unit}</span></p>
            <span class="teaser__body">
              <h3 class="teaser__q">{t.q}</h3>
              <p class="teaser__a">{t.a}</p>
              <span class="teaser__link">{t.link}</span>
            </span>
            <span class="teaser__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  
  <section class="section">
    <div class="wrap voice">
      <FigureBlock src={photos.home.voice.src} alt={photos.home.voice.alt} caption={photos.home.voice.caption} ratio={photos.home.voice.ratio} />
      <div class="voice__body">
        <p class="eyebrow">先听果园里的一句话</p>
        <p class="quote-block">「{voice.quote}」</p>
        <p class="note">{voice.name} · {voice.role}<SourceBadge src={voice.src} /></p>
        <div class="voice__cta">
          <p class="muted">一季收成背后，是种植户、技术员、分选工和电商经营者共同接住的一条产业链。</p>
          <a class="btn btn--solid" href="/jiashi-xinmei-site/people">看新梅人的故事 →</a>
        </div>
      </div>
    </div>
  </section>

  </BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: visible;
    padding-block: clamp(2.6rem, 1.4rem + 6vw, 5.5rem) clamp(2rem, 1rem + 3vw, 3rem);
    background: linear-gradient(135deg, #eee6dc 0%, #f4eee7 62%, #e8e0d7 100%);
    border-bottom: 1px solid var(--c-line);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    background-image: linear-gradient(90deg, transparent 0 92%, rgba(109, 52, 85, 0.08) 92% 92.1%, transparent 92.1%), linear-gradient(0deg, transparent 0 92%, rgba(168, 121, 61, 0.08) 92% 92.1%, transparent 92.1%);
    background-size: 120px 120px;
  }
  .hero__inner {
    display: grid;
    gap: clamp(1rem, 0.4rem + 2vw, 2.4rem) var(--gap);
    grid-template-columns: 1fr;
    align-items: center;
  }
  .hero__title { font-size: var(--step-4); margin-bottom: 0.1em; }
  .hero__sub {
    font-family: var(--font-title);
    font-size: var(--step-2);
    color: var(--c-plum);
    margin: 0 0 1rem;
  }
  .hero__lead { font-size: var(--step-1); max-width: 46ch; color: var(--c-plum-deep); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1.3rem 0 0; }

  .hero__art {
    width: min(92vw, 520px);
    position: relative;
    margin: 0 auto;
    transform: none;
  }
  .hero__art img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    display: block;
    object-fit: cover;
    object-position: 46% 48%;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 24px 24px 24px 6px;
    background: #536b4d;
    box-shadow: 0 26px 44px rgba(58, 27, 71, 0.2);
    transition: transform 0.8s var(--ease);
  }
  .hero__art figcaption {
    margin-top: 0.7rem;
    color: var(--c-muted);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-align: center;
  }
  .hero__art:hover img { transform: scale(1.025); }
  .hero__art {
    margin-inline: auto;
  }

  .hero__stats { margin-top: 0.5rem; grid-template-columns: repeat(3, minmax(0, 1fr)); position: relative; z-index: 1; }
  .hero__stats .stat { min-width: 0; padding-inline: clamp(0.8rem, 0.4rem + 1vw, 1.35rem); }

  .hero__cue {
    display: grid;
    place-items: center;
    margin-top: clamp(1.4rem, 1rem + 2vw, 2.6rem);
  }

  @media screen and (min-width: 1000px) and (orientation: landscape) {
    .hero { padding-block: 3.2rem 2rem; }
    .hero__inner { gap: 1.2rem var(--gap); }
    .hero__lead { max-width: 52ch; }
    .hero__cta { margin-top: 1rem; }
    .hero__art { width: min(100%, 500px); }
    .hero__stats { margin-top: 0.2rem; }
    .hero__cue { margin-top: 1.2rem; }
  }
  .hero__cue span {
    width: 15px;
    height: 15px;
    border-right: 2px solid color-mix(in srgb, var(--c-plum) 55%, transparent);
    border-bottom: 2px solid color-mix(in srgb, var(--c-plum) 55%, transparent);
    transform: rotate(45deg);
    animation: heroCue 2.2s var(--ease) infinite;
  }

  .teaser-list { display: grid; grid-template-columns: 1fr; }
  .teaser {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--c-outline-variant);
    color: var(--c-plum-deep);
    text-decoration: none;
    transition: background 0.2s var(--ease), padding-inline 0.2s var(--ease);
  }
  .teaser:last-child { border-bottom: 1px solid var(--c-outline-variant); }
  .teaser:hover, .teaser:focus-visible { padding-inline: 0.75rem; background: color-mix(in srgb, var(--c-surface-variant) 46%, transparent); }
  .teaser__num {
    font-family: var(--font-num);
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 2.7rem);
    line-height: 1;
    color: var(--c-plum);
    margin: 0 0 0.7rem;
  }
  .teaser__unit { font-size: 0.95rem; color: var(--c-muted); margin-left: 0.3rem; }
  .teaser__body { min-width: 0; }
  .teaser__q { font-size: var(--step-1); margin: 0 0 0.35rem; color: var(--c-plum-deep); }
  .teaser__a { margin: 0 0 0.55rem; font-size: 0.92rem; color: var(--c-muted); }
  .teaser__link {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-gold);
    font-weight: 600;
  }
  .teaser__arrow { color: var(--c-plum); font-size: 1.35rem; transition: transform 0.2s var(--ease); }
  .teaser:hover .teaser__arrow, .teaser:focus-visible .teaser__arrow { transform: translateX(4px); }

  .voice { display: grid; gap: var(--gap); grid-template-columns: 1fr; align-items: center; }
  .voice__body { display: grid; gap: 0.9rem; }
  .voice__cta { display: grid; gap: 0.8rem; justify-items: start; padding-top: 1rem; border-top: 1px solid var(--c-line); }

  .workinfo { margin: 0; display: grid; gap: 0; grid-template-columns: 1fr; }
  .workinfo__row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px dashed var(--c-line);
  }
  .workinfo__row:first-child { border-top: 1px dashed var(--c-line); }
  .workinfo dt { color: var(--c-muted); font-size: 0.9rem; }
  .workinfo dd { margin: 0; color: var(--c-plum-deep); font-size: 0.95rem; }

  @keyframes heroCue {
    0%, 100% { transform: rotate(45deg) translate(0, 0); opacity: 0.5; }
    50% { transform: rotate(45deg) translate(5px, 5px); opacity: 1; }
  }
  @media (min-width: 760px) {
    .hero__inner { grid-template-columns: 1.12fr 0.88fr; }
    .hero__text { grid-column: 1; }
    .hero__art { grid-column: 2; grid-row: 1; width: min(100%, 460px); }
    .hero__stats { grid-column: 1 / -1; }
    .voice { grid-template-columns: 0.9fr 1.1fr; align-items: center; }
  }
  @media (max-width: 699px) {
    .hero__stats { grid-template-columns: 1fr; }
    .teaser { grid-template-columns: 5rem minmax(0, 1fr) auto; gap: 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue span { animation: none; }
  }
</style>
